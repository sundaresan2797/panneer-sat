APP_ENV=production

# Used for canonical URLs, sitemap.xml, robots.txt and structured data.
SITE_URL=https://www.example.com

# SMTP credentials for sending enquiry emails. Leave blank in development —
# enquiries are still accepted and logged, just not emailed, until these are set.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=

# Enquiries are emailed to this address.
CONTACT_EMAIL=

# WhatsApp number in international format, digits only (e.g. 91XXXXXXXXXX).
# See BUSINESS_DETAILS_TO_CONFIRM.md — do not guess this value.
WHATSAPP_NUMBER=

# Every quote-form enquiry is also logged as a row in this Google Sheet, so
# there's a durable record even if the email fails. Requires:
#  1. GOOGLE_SHEET_ID       — the spreadsheet ID from its URL
#     (https://docs.google.com/spreadsheets/d/<THIS_PART>/edit)
#  2. GOOGLE_SHEET_TAB      — the tab name (defaults to "Enquiries")
#  3. The service account's email must be added as an Editor on that sheet
#     (Share button in Google Sheets).
#  4. Credentials — set ONE of the two below:
#     - GOOGLE_SERVICE_ACCOUNT_JSON: paste the full service-account key file
#       content as one line (use this on Vercel — never commit the key file).
#     - GOOGLE_APPLICATION_CREDENTIALS: a path to the key file, relative to
#       the project root (e.g. secrets/google-service-account.json) so it
#       works on any machine/clone, not just the one that wrote this file.
#       Local development only; keep the file itself out of git.
GOOGLE_SHEET_ID=
GOOGLE_SHEET_TAB=Enquiries
GOOGLE_SERVICE_ACCOUNT_JSON=
GOOGLE_APPLICATION_CREDENTIALS=secrets/google-service-account.json
